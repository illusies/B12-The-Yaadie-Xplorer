---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy - The Yaadie Xplorer">
  <section id="privacy-header" class="bg-gradient-to-r from-primary to-green-800 text-white py-12">
    <div class="section-container">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Privacy Policy</h1>
      <p class="text-lg text-gray-100">How we protect and use your personal information</p>
    </div>
  </section>

  <div class="section-container py-12 max-w-3xl">
    <div class="bg-white rounded-xl shadow-lg p-8 space-y-8">
      <!-- Last Updated -->
      <p class="text-sm text-muted-foreground">Last updated: July 2026</p>

      <!-- Introduction -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">Privacy Policy</h2>
        <p class="text-foreground">
          The Yaadie Xplorer Tours and Transfers ("Company", "we", "us", "our") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, disclose, and protect your information when you visit our website and book our services.
        </p>
      </section>

      <!-- 1. Information We Collect -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">1. Information We Collect</h2>

        <h3 class="font-bold text-foreground mb-3 mt-4">Personal Information You Provide:</h3>
        <ul class="space-y-2 text-foreground ml-4 mb-4">
          <li>• Full name, email address, phone number</li>
          <li>• Mailing address and billing information</li>
          <li>• Passport/ID information (for verification)</li>
          <li>• Payment information (credit card details)</li>
          <li>• Special requirements and preferences</li>
          <li>• Travel dates and group composition</li>
        </ul>

        <h3 class="font-bold text-foreground mb-3">Automatically Collected Information:</h3>
        <ul class="space-y-2 text-foreground ml-4">
          <li>• Browser type and IP address</li>
          <li>• Pages visited and time spent</li>
          <li>• Cookies and tracking information</li>
          <li>• Device type and operating system</li>
        </ul>
      </section>

      <!-- 2. How We Use Your Information -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">2. How We Use Your Information</h2>
        <ul class="space-y-3 text-foreground">
          <li><strong>Tour Processing:</strong> To confirm bookings, send confirmations, and process payments</li>
          <li><strong>Communication:</strong> To respond to inquiries and provide customer support</li>
          <li><strong>Updates:</strong> To send tour reminders, itineraries, and important updates</li>
          <li><strong>Marketing:</strong> To send newsletters, promotions, and travel tips (with your consent)</li>
          <li><strong>Safety:</strong> To ensure guest safety and manage liability waivers</li>
          <li><strong>Improvement:</strong> To analyze website usage and improve our services</li>
          <li><strong>Legal Compliance:</strong> To comply with legal obligations and regulations</li>
        </ul>
      </section>

      <!-- 3. Data Sharing -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">3. Data Sharing & Third Parties</h2>
        <p class="text-foreground mb-4">
          We do not sell your personal information. However, we may share data with:
        </p>
        <ul class="space-y-3 text-foreground ml-4">
          <li><strong>Payment Processors:</strong> To securely process credit card and PayPal transactions</li>
          <li><strong>Tour Partners:</strong> Hotels, transportation providers, and activity operators needed to deliver your tour</li>
          <li><strong>Emergency Services:</strong> Medical or emergency information if necessary for your safety</li>
          <li><strong>Legal Authorities:</strong> When required by law or to protect our rights</li>
        </ul>
        <p class="text-foreground mt-4">
          All third parties are contractually obligated to protect your information and use it only for the specified purposes.
        </p>
      </section>

      <!-- 4. Data Security -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">4. Data Security</h2>
        <p class="text-foreground mb-4">
          We implement industry-standard security measures to protect your personal information:
        </p>
        <ul class="space-y-2 text-foreground ml-4">
          <li>• Encryption of sensitive data (SSL/TLS)</li>
          <li>• Secure payment processing</li>
          <li>• Limited access to personal information</li>
          <li>• Regular security audits and updates</li>
          <li>• Secure data disposal practices</li>
        </ul>
        <p class="text-foreground mt-4">
          While we strive to protect your information, no system is 100% secure. We cannot guarantee absolute security.
        </p>
      </section>

      <!-- 5. Cookies & Tracking -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">5. Cookies & Tracking Technologies</h2>
        <p class="text-foreground mb-4">
          Our website uses cookies and similar technologies to enhance user experience and analyze website performance:
        </p>
        <ul class="space-y-3 text-foreground ml-4">
          <li><strong>Essential Cookies:</strong> Required for website functionality</li>
          <li><strong>Analytics Cookies:</strong> Help us understand how visitors use our site</li>
          <li><strong>Marketing Cookies:</strong> Used for retargeting and personalized ads</li>
        </ul>
        <p class="text-foreground mt-4">
          You can control cookie preferences through your browser settings. Disabling cookies may affect website functionality.
        </p>
      </section>

      <!-- 6. Your Rights -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">6. Your Rights</h2>
        <p class="text-foreground mb-4">You have the right to:</p>
        <ul class="space-y-2 text-foreground ml-4">
          <li>• Access your personal data</li>
          <li>• Request correction of inaccurate information</li>
          <li>• Request deletion of your data</li>
          <li>• Opt-out of marketing communications</li>
          <li>• Request a copy of your data in portable format</li>
        </ul>
        <p class="text-foreground mt-4">
          To exercise these rights, contact us at theyaadiexplorer@gmail.com with your request.
        </p>
      </section>

      <!-- 7. Marketing Communications -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">7. Marketing Communications</h2>
        <p class="text-foreground mb-4">
          We'd love to keep you updated with travel tips, special offers, and new tours. You can:
        </p>
        <ul class="space-y-2 text-foreground ml-4">
          <li>• Opt-in to our newsletter during booking</li>
          <li>• Opt-out anytime by clicking "Unsubscribe" in any email</li>
          <li>• Manage preferences in your account settings</li>
        </ul>
        <p class="text-foreground mt-4">
          Even if you opt-out of marketing, we'll still send you transactional emails (confirmations, reminders, receipts).
        </p>
      </section>

      <!-- 8. Children's Privacy -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">8. Children's Privacy</h2>
        <p class="text-foreground">
          Our website is not intended for children under 13. We do not knowingly collect personal information from children. If we become aware that a child has provided information, we will delete it promptly.
        </p>
      </section>

      <!-- 9. Data Retention -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">9. Data Retention</h2>
        <p class="text-foreground">
          We retain your personal information for as long as necessary to fulfill the purposes outlined in this policy. Booking information is retained for accounting and legal compliance (typically 7 years). You may request deletion anytime.
        </p>
      </section>

      <!-- 10. International Data Transfers -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">10. International Data Transfers</h2>
        <p class="text-foreground">
          Your information may be transferred to, stored in, and processed in Jamaica or other countries. By using our services, you consent to such transfers. We ensure appropriate safeguards are in place.
        </p>
      </section>

      <!-- 11. Third-Party Links -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">11. Third-Party Websites</h2>
        <p class="text-foreground">
          Our website may contain links to third-party websites. We are not responsible for their privacy practices. Please review their privacy policies before providing personal information.
        </p>
      </section>

      <!-- 12. Policy Changes -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">12. Changes to This Privacy Policy</h2>
        <p class="text-foreground">
          We may update this Privacy Policy periodically. Changes will be posted with an updated "Last Updated" date. Continued use of our website constitutes acceptance of updated terms.
        </p>
      </section>

      <!-- 13. Contact Information -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">13. Contact Us</h2>
        <p class="text-foreground mb-3">If you have questions about this Privacy Policy or our practices, please contact:</p>
        <div class="bg-gray-50 p-4 rounded-lg">
          <p><strong>The Yaadie Xplorer Tours and Transfers</strong></p>
          <p>📍 Lot 1220 Porto Bello Meadows, Montego Bay, Jamaica</p>
          <p>📞 876-326-3354</p>
          <p>✉️ theyaadiexplorer@gmail.com</p>
          <p>🕒 9am - 6pm EST</p>
        </div>
      </section>

      <!-- Consent -->
      <div class="bg-blue-50 border-l-4 border-primary p-4 rounded mt-8">
        <p class="text-sm text-foreground">
          <strong>By using The Yaadie Xplorer website and services, you consent to our Privacy Policy and our processing of your personal information as described herein.</strong>
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  @reference "../styles/global.css";
</style>
