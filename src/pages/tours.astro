---

<Layout title="Tours & Experiences - The Yaadie Xplorer">
  <section id="tours-header" class="bg-gradient-to-r from-primary to-green-800 text-white py-12">
    <div class="section-container">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Tours & Experiences</h1>
      <p class="text-lg text-gray-100">Discover 43+ curated tours showcasing Jamaica's best</p>
    </div>
  </section>

  <div class="section-container py-12">
    <!-- Filter Buttons -->
    <div class="mb-12">
      <h3 class="text-lg font-semibold text-foreground mb-4">Filter by Category</h3>
      <div class="flex flex-wrap gap-3">
        {categories.map((cat) => (
          <button
            class={`px-4 py-2 rounded-full font-semibold transition-all ${
              cat === 'All'
                ? 'bg-primary text-white'
                : 'bg-gray-200 text-foreground hover:bg-secondary hover:text-black'
            }`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Tours Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {tours.map((tour) => (
        <div class="tour-card group" data-category={tour.category} data-tour-id={tour.id}>
          <div class="relative overflow-hidden h-48 bg-gray-200">
            <img
              src={underseaImage}
              alt={tour.name}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
            />
            <div class="absolute top-3 left-3 bg-black/70 text-white px-3 py-1 rounded-full text-xs font-semibold">
              {tour.category}
            </div>
            {tour.perks && (
              <div class="absolute top-3 right-3">
                <span class="perks-badge">With Perks!</span>
              </div>
            )}
          </div>
          <div class="p-4">
            <h3 class="font-bold text-lg text-foreground mb-2">{tour.name}</h3>
            <p class="text-sm text-muted-foreground mb-4">{tour.description}</p>
            <div class="flex items-center gap-1 mb-3">
              <div class="flex items-center gap-0.5">
                {[...Array(5)].map((_, i) => (
                  <Star
                    key={i}
                    size={14}
                    class={i < Math.floor(tour.rating) ? 'fill-secondary text-secondary' : 'text-gray-300'}
                  />
                ))}
              </div>
              <span class="text-xs text-muted-foreground">{tour.rating}</span>
            </div>
            <div class="pt-4 border-t border-border space-y-3">
              <div class="text-primary font-bold text-sm">
                {tour.priceDetails ? tour.priceDetails : `$${tour.price}${tour.priceType ? ' ' + tour.priceType : ''}`}
              </div>
              <a href="/signup" class="w-full inline-block text-center bg-secondary text-black py-2 px-4 rounded-md font-semibold hover:bg-amber-300 transition-colors">
                Book Now
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Custom Tours & Perks Note -->
    <div class="bg-gradient-to-r from-green-50 to-amber-50 rounded-lg p-6 mb-8 border-l-4 border-primary">
      <p class="text-foreground text-center">
        <strong>Custom tours available upon request.</strong> Complimentary rum punch, Red Stripe, water, and coconut water included on selected tours.
      </p>
    </div>
  </div>

  <!-- CTA Section -->
  <section class="bg-secondary text-black py-12">
    <div class="section-container text-center">
      <h2 class="text-3xl font-bold mb-4">Can't Find Your Dream Tour?</h2>
      <p class="text-lg mb-6 max-w-2xl mx-auto">Create a custom itinerary tailored to your interests and group size</p>
      <a href="/custom-tour" class="btn-primary">Create Custom Tour</a>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('button[data-category]');
    const tourCards = document.querySelectorAll('.tour-card[data-tour-id]');

    filterButtons?.forEach(button => {
      button.addEventListener('click', () => {
        const selectedCategory = button.getAttribute('data-category');

        // Update active button
        filterButtons.forEach(btn => {
          btn.classList.remove('bg-primary', 'text-white');
          btn.classList.add('bg-gray-200', 'text-foreground');
        });
        button.classList.add('bg-primary', 'text-white');
        button.classList.remove('bg-gray-200', 'text-foreground');

        // Filter tours
        tourCards?.forEach(card => {
          const category = card.getAttribute('data-category');
          if (selectedCategory === 'All' || category === selectedCategory) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  @reference "../styles/global.css";
</style>
