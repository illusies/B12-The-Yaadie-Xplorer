---
import Layout from '../layouts/Layout.astro'
import AccountDashboard from '../components/AccountDashboard'
---

<Layout title="My Account - The Yaadie Xplorer">
  <section id="account-header" class="bg-gradient-to-r from-primary to-green-800 text-white py-12">
    <div class="section-container">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">My Account</h1>
      <p class="text-lg text-gray-100">Manage your bookings and profile</p>
    </div>
  </section>

  <div class="section-container py-12">
    <AccountDashboard client:load />
  </div>
</Layout>

<style>
  @reference "../styles/global.css";
</style>
