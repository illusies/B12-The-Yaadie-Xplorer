---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms & Conditions - The Yaadie Xplorer">
  <section id="terms-header" class="bg-gradient-to-r from-primary to-green-800 text-white py-12">
    <div class="section-container">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Terms & Conditions</h1>
      <p class="text-lg text-gray-100">Please read carefully before booking your tour</p>
    </div>
  </section>

  <div class="section-container py-12 max-w-3xl">
    <div class="bg-white rounded-xl shadow-lg p-8 space-y-8">
      <!-- Last Updated -->
      <p class="text-sm text-muted-foreground">Last updated: July 2026</p>

      <!-- 1. Agreement -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">1. Agreement to Terms</h2>
        <p class="text-foreground mb-4">
          By accessing and using The Yaadie Xplorer website and booking any tour or service, you agree to be bound by these Terms & Conditions. If you do not agree with any part of these terms, please do not use our services.
        </p>
      </section>

      <!-- 2. Booking & Reservations -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">2. Booking & Reservations</h2>
        <ul class="space-y-3 text-foreground">
          <li><strong>Confirmation:</strong> All bookings must be confirmed with a 30% non-refundable deposit. Final balance is due 7 days before your tour.</li>
          <li><strong>Accuracy:</strong> You are responsible for providing accurate personal information during booking, including names, dates, and special requirements.</li>
          <li><strong>Age Restrictions:</strong> Some tours have age or height restrictions for safety reasons. Please verify tour requirements before booking.</li>
          <li><strong>Group Bookings:</strong> Groups of 8+ may have different terms; please contact us for specific details.</li>
        </ul>
      </section>

      <!-- 3. Cancellation Policy -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">3. Cancellation & Refund Policy</h2>
        <p class="text-foreground mb-3"><strong>Standard Tours:</strong></p>
        <ul class="space-y-2 text-foreground ml-4 mb-4">
          <li>• 4+ days notice: 100% refund (less deposit)</li>
          <li>• 3 days notice: 75% refund</li>
          <li>• 2 days notice: 50% refund</li>
          <li>• 1 day or less: No refund</li>
        </ul>
        <p class="text-foreground mb-3"><strong>Custom Tours & Charters:</strong></p>
        <ul class="space-y-2 text-foreground ml-4">
          <li>• 60+ days notice: 100% refund</li>
          <li>• 59-44 days: 50% refund</li>
          <li>• 45-30 days: 25% refund</li>
          <li>• Less than 30 days: No refund</li>
        </ul>
      </section>

      <!-- 4. Payment -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">4. Payment Terms</h2>
        <ul class="space-y-3 text-foreground">
          <li><strong>Accepted Methods:</strong> We accept credit/debit cards, PayPal, and bank transfers.</li>
          <li><strong>Deposit:</strong> A 30% non-refundable deposit is required to secure your booking.</li>
          <li><strong>Final Payment:</strong> Final balance is due 7 days before the tour date.</li>
          <li><strong>Currency:</strong> All prices are quoted in USD. Rates are subject to change without notice.</li>
          <li><strong>Late Payment:</strong> Tours may be cancelled if final payment is not received by the due date.</li>
        </ul>
      </section>

      <!-- 5. Liability & Waiver -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">5. Liability & Assumption of Risk</h2>
        <p class="text-foreground mb-4">
          <strong>Assumption of Risk:</strong> By booking a tour, you acknowledge that adventure activities involve inherent risks including but not limited to physical injury, property damage, or death. You voluntarily assume all risks.
        </p>
        <p class="text-foreground mb-4">
          <strong>Release of Liability:</strong> You agree to release, indemnify, and hold harmless The Yaadie Xplorer, its owners, guides, and employees from any claims, damages, or liability arising from your participation in tours, except where prohibited by law.
        </p>
        <p class="text-foreground">
          <strong>Insurance:</strong> We recommend obtaining travel and activity insurance to cover unforeseen circumstances. The Yaadie Xplorer is not responsible for losses due to accidents, illness, or cancellations.
        </p>
      </section>

      <!-- 6. Health & Medical -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">6. Health & Medical Conditions</h2>
        <ul class="space-y-3 text-foreground">
          <li><strong>Disclosure:</strong> You must disclose any medical conditions, allergies, or physical limitations before booking.</li>
          <li><strong>Fitness Level:</strong> Participants must be in reasonable physical health. Some tours are physically demanding.</li>
          <li><strong>Pregnancy:</strong> Pregnant guests should consult with their physician and inform us in advance. Some activities are not suitable for pregnant guests.</li>
          <li><strong>Medical Emergencies:</strong> In case of medical emergency, we will provide first aid and arrange evacuation. You are responsible for medical costs.</li>
        </ul>
      </section>

      <!-- 7. Weather & Natural Events -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">7. Weather & Force Majeure</h2>
        <p class="text-foreground mb-4">
          Tours may be postponed or cancelled due to severe weather, hurricanes, natural disasters, or other unforeseen circumstances beyond our control. In such cases, you will be offered a full refund or rescheduling at no extra cost.
        </p>
      </section>

      <!-- 8. Guest Conduct -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">8. Guest Conduct</h2>
        <p class="text-foreground mb-4">Guests must:</p>
        <ul class="space-y-2 text-foreground ml-4">
          <li>• Follow all guide instructions and safety protocols</li>
          <li>• Respect local culture and environment</li>
          <li>• Not engage in illegal activities, including drug/alcohol abuse</li>
          <li>• Not disrupt other guests' experiences</li>
          <li>• Comply with all local laws and regulations</li>
        </ul>
        <p class="text-foreground mt-4">
          The Yaadie Xplorer reserves the right to deny participation or remove guests for violation of these conduct standards without refund.
        </p>
      </section>

      <!-- 9. Modifications -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">9. Modifications to Tours</h2>
        <p class="text-foreground">
          The Yaadie Xplorer reserves the right to modify tour itineraries, routes, or activities due to operational, safety, or weather-related reasons. We will notify you of changes as soon as possible.
        </p>
      </section>

      <!-- 10. Limitation of Liability -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">10. Limitation of Liability</h2>
        <p class="text-foreground">
          To the maximum extent permitted by law, The Yaadie Xplorer's total liability to you shall not exceed the amount paid for the tour. We are not liable for indirect, incidental, or consequential damages.
        </p>
      </section>

      <!-- 11. Dispute Resolution -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">11. Dispute Resolution</h2>
        <p class="text-foreground">
          Any disputes arising from these terms shall be governed by the laws of Jamaica. Both parties agree to attempt informal resolution before pursuing legal action.
        </p>
      </section>

      <!-- 12. Contact Information -->
      <section>
        <h2 class="text-2xl font-bold text-primary mb-4">12. Contact Information</h2>
        <p class="text-foreground mb-3">For questions regarding these terms, please contact:</p>
        <div class="bg-gray-50 p-4 rounded-lg">
          <p><strong>The Yaadie Xplorer Tours and Transfers</strong></p>
          <p>📍 Lot 1220 Porto Bello Meadows, Montego Bay, Jamaica</p>
          <p>📞 876-326-3354</p>
          <p>✉️ theyaadiexplorer@gmail.com</p>
          <p>🕒 9am - 6pm EST</p>
        </div>
      </section>

      <!-- Acceptance -->
      <div class="bg-blue-50 border-l-4 border-primary p-4 rounded">
        <p class="text-sm text-foreground">
          <strong>By booking a tour with The Yaadie Xplorer, you acknowledge that you have read, understood, and agree to these Terms & Conditions.</strong>
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  @reference "../styles/global.css";
</style>
