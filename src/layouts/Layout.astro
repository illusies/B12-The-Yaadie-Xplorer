---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RequiredB12HeadScripts from '../components/RequiredB12HeadScripts.astro';
import RequiredB12FooterScripts from '../components/RequiredB12FooterScripts.astro';
import BackToTopButton from '../components/BackToTopButton.astro';

interface Props {
  title?: string;
}

const { title = 'The Yaadie Xplorer - Jamaican Tours & Transfers' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Premium Jamaican tours, transfers, and adventures with The Yaadie Xplorer. Catamaran cruises, Dunn's River Falls, private yacht charters, and more." />
    <link rel="icon" type="image/jpeg" href="https://cdn.b12.io/client_media/0Btv6XcI/33649ad2-8725-11f1-a122-0242ac110002-IMG-20260624-WA0015.jpg" />
    <RequiredB12HeadScripts />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <BackToTopButton />
    <RequiredB12FooterScripts />
  </body>
</html>

<style>
  @reference "../styles/global.css";
</style>
